generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  OWNER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SportsType {
  FOOTBALL
  CRICKET
}

enum TurfStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  UNDER_REVIEW
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutMethod {
  UPI
  BANK
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT_STAFF
}

enum AdminActionType {
  USER_BANNED
  USER_UNBANNED
  TURF_SUSPENDED
  TURF_UNSUSPENDED
  TURF_ACTIVATED
  TURF_FEATURED
  TURF_UNFEATURED
  OWNER_BANNED
  OWNER_UNBANNED
  BOOKING_CANCELLED
  BOOKING_REFUNDED
  PRICE_OVERRIDE
  REVIEW_REMOVED
  KYC_APPROVED
  KYC_REJECTED
  ADMIN_CREATED
  ADMIN_DEACTIVATED
  SYSTEM_CONFIG_CHANGED
  NOTIFICATION_SENT
  SUPPORT_TICKET_REPLIED
  LEADERBOARD_RESET
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── ADMIN MODELS ───────────────────────────────────────────────────────────

model Admin {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            AdminRole @default(ADMIN)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  passwordChanged DateTime  @default(now())
  refreshToken    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    AdminSession[]
  actionLogs  AdminActionLog[]

  @@index([email])
  @@index([role])
}

model AdminSession {
  id           String    @id @default(uuid())
  adminId      String
  tokenHash    String    @unique
  ipAddress    String
  userAgent    String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([adminId])
}

model AdminActionLog {
  id          String          @id @default(uuid())
  adminId     String
  action      AdminActionType
  targetType  String
  targetId    String
  reason      String?
  metadata    Json?
  ipAddress   String
  createdAt   DateTime        @default(now())

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

// ─── USER / OWNER MODELS ────────────────────────────────────────────────────

model Auth {
  id         String    @id @default(uuid())
  phone      String    @unique
  role       Role      @default(USER)
  isVerified Boolean   @default(false)
  isActive   Boolean   @default(true)
  isBanned   Boolean   @default(false)
  banReason  String?
  bannedAt   DateTime?
  bannedBy   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  sessions     Session[]
  otpEntries   OtpEntry[]
  userProfile  UserProfile?
  ownerProfile OwnerProfile?
  payment      Payment?

  @@index([phone])
  @@index([role])
}

model UserProfile {
  id          String    @id @default(uuid())
  authId      String    @unique
  name        String
  email       String    @unique
  avatarUrl   String?
  dob         DateTime
  gender      Gender
  currentLat  Float?
  currentLng  Float?
  currentCity String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auth     Auth      @relation(fields: [authId], references: [id], onDelete: Cascade)
  payment  Payment?
  bookings Booking[]
  reviews  Review[]
}

model OwnerProfile {
  id            String    @id @default(uuid())
  authId        String    @unique
  name          String
  email         String    @unique
  contactNumber String
  avatarUrl     String?
  aadharNumber  String?
  aadharUrl     String?
  isKycVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auth    Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  turfs   Turf[]
  payment Payment?

  @@index([authId])
}

// ─── TURF ────────────────────────────────────────────────────────────────────

model Turf {
  id                  String     @id @default(uuid())
  ownerProfileId      String
  name                String
  description         String?
  sportsType          SportsType
  turfSize            String
  status              TurfStatus @default(ACTIVE)
  isFeatured          Boolean    @default(false)
  featuredAt          DateTime?
  featuredBy          String?
  suspensionReason    String?
  suspendedAt         DateTime?
  suspendedBy         String?

  address             String
  city                String
  pincode             String
  lat                 Float
  lng                 Float

  openTime            String
  closeTime           String
  minSlotDurationMins Int

  groundDayUrl        String?
  groundNightUrl      String?
  entranceUrl         String?

  floodLights         Boolean    @default(false)
  parking             Boolean    @default(false)
  washroom            Boolean    @default(false)
  changingRoom        Boolean    @default(false)
  drinkingWater       Boolean    @default(false)
  seatingArea         Boolean    @default(false)
  cafeteria           Boolean    @default(false)

  weekdayDayPrice     Float
  weekdayNightPrice   Float
  weekendDayPrice     Float
  weekendNightPrice   Float

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  owner        OwnerProfile   @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  reviews      Review[]
  priceHistory PriceHistory[]

  @@index([ownerProfileId])
  @@index([city])
  @@index([status])
  @@index([isFeatured])
}

// ─── BOOKING ─────────────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(uuid())
  userProfileId   String
  turfId          String
  bookingDate     DateTime
  slotStartTime   String
  slotEndTime     String
  durationMins    Int
  totalAmount     Float
  platformFee     Float         @default(0)
  ownerPayout     Float         @default(0)
  status          BookingStatus @default(PENDING)
  paymentMethod   String?
  transactionId   String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user UserProfile @relation(fields: [userProfileId], references: [id])
  turf Turf        @relation(fields: [turfId], references: [id])

  @@index([userProfileId])
  @@index([turfId])
  @@index([status])
  @@index([bookingDate])
  @@index([createdAt])
}

// ─── REVIEW ──────────────────────────────────────────────────────────────────

model Review {
  id            String   @id @default(uuid())
  userProfileId String
  turfId        String
  rating        Int
  comment       String?
  isVisible     Boolean  @default(true)
  isFlagged     Boolean  @default(false)
  flagReason    String?
  flaggedBy     String?
  removedBy     String?
  removeReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user UserProfile @relation(fields: [userProfileId], references: [id])
  turf Turf        @relation(fields: [turfId], references: [id])

  @@unique([userProfileId, turfId])
  @@index([turfId])
  @@index([rating])
  @@index([isFlagged])
}

// ─── PRICE HISTORY ───────────────────────────────────────────────────────────

model PriceHistory {
  id                  String   @id @default(uuid())
  turfId              String
  weekdayDayPrice     Float
  weekdayNightPrice   Float
  weekendDayPrice     Float
  weekendNightPrice   Float
  changedBy           String
  changeReason        String?
  createdAt           DateTime @default(now())

  turf Turf @relation(fields: [turfId], references: [id])

  @@index([turfId])
  @@index([createdAt])
}

// ─── PAYMENT ─────────────────────────────────────────────────────────────────

model Payment {
  id             String   @id @default(uuid())
  authId         String   @unique
  role           Role
  upiId          String
  userProfileId  String?  @unique
  ownerProfileId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  auth         Auth          @relation(fields: [authId], references: [id], onDelete: Cascade)
  userProfile  UserProfile?  @relation(fields: [userProfileId], references: [id])
  ownerProfile OwnerProfile? @relation(fields: [ownerProfileId], references: [id])

  @@index([authId])
  @@index([role])
}

// ─── SESSION / OTP ───────────────────────────────────────────────────────────

model Session {
  id        String    @id @default(uuid())
  authId    String
  token     String    @unique @default(uuid())
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([authId])
}

model OtpEntry {
  id           String    @id @default(uuid())
  authId       String
  sessionToken String    @unique @default(uuid())
  code         String
  expiresAt    DateTime
  verifiedAt   DateTime?
  resendCount  Int       @default(0)
  lastResentAt DateTime?
  createdAt    DateTime  @default(now())

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([authId])
}

// ─── PLATFORM CONFIG ─────────────────────────────────────────────────────────

model PlatformConfig {
  id                          String   @id @default(uuid())
  platformFeePercent          Float    @default(10)
  gstPercent                  Float    @default(18)
  minBookingAmount            Float    @default(100)
  maxRefundDays               Int      @default(7)
  cancellationAllowedHours    Int      @default(2)
  cancellationRefundPercent   Float    @default(75)
  maxBookingsPerUser          Int      @default(5)
  maintenanceMode             Boolean  @default(false)
  bookingEnabled              Boolean  @default(true)
  registrationEnabled         Boolean  @default(true)
  updatedBy                   String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// ─── SUPPORT TICKET ──────────────────────────────────────────────────────────

model SupportTicket {
  id          String         @id @default(uuid())
  userId      String
  userRole    Role
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedTo  String?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  replies SupportTicketReply[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([createdAt])
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  senderType String  // 'admin' | 'user' | 'owner'
  message   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

// ─── NOTIFICATION LOG ────────────────────────────────────────────────────────

model NotificationLog {
  id          String   @id @default(uuid())
  title       String
  body        String
  targetType  String   // 'all_users', 'all_owners', 'specific', 'topic'
  targetIds   String[] @default([])
  sentBy      String
  sentCount   Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([sentBy])
  @@index([targetType])
  @@index([createdAt])
}

// ─── USER GAMIFICATION (for leaderboard) ─────────────────────────────────────

model UserGamification {
  id             String    @id @default(uuid())
  authId         String    @unique @map("auth_id")
  streak         Int       @default(0)
  points         Int       @default(0)
  totalMatches   Int       @default(0) @map("total_matches")
  totalHours     Float     @default(0) @map("total_hours")
  lastPlayedDate DateTime? @map("last_played_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([points])
  @@map("user_gamification")
}
