generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Auth {
  id           String        @id @default(uuid())
  phone        String        @unique
  role         Role          @default(USER)
  isVerified   Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  otpEntries   OtpEntry[]
  ownerProfile OwnerProfile?
  payment      Payment?
  sessions     Session[]
  userProfile  UserProfile?
  bookings     Booking[]
  savedTurfs   SavedTurf[]
  ratings      TurfRating[]

  @@index([phone])
  @@index([role])
}

model UserProfile {
  id          String   @id @default(uuid())
  authId      String   @unique
  name        String
  email       String   @unique
  avatarUrl   String?
  dob         DateTime
  gender      Gender
  currentLat  Float?
  currentLng  Float?
  currentCity String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payment     Payment?
  auth        Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id            String   @id @default(uuid())
  authId        String   @unique
  name          String
  email         String   @unique
  contactNumber String
  avatarUrl     String?
  aadharNumber  String
  aadharUrl     String?
  isKycVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  auth          Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  payment       Payment?
  turfs         Turf[]

  @@index([authId])
}

model Turf {
  id                  String       @id @default(uuid())
  ownerProfileId      String
  name                String
  description         String?
  sportsType          SportsType
  turfSize            String
  status              TurfStatus   @default(ACTIVE)
  address             String
  city                String
  pincode             String
  lat                 Float
  lng                 Float
  openTime            String
  closeTime           String
  minSlotDurationMins Int
  groundDayUrl        String?
  groundNightUrl      String?
  entranceUrl         String?
  floodLights         Boolean      @default(false)
  parking             Boolean      @default(false)
  washroom            Boolean      @default(false)
  changingRoom        Boolean      @default(false)
  drinkingWater       Boolean      @default(false)
  seatingArea         Boolean      @default(false)
  cafeteria           Boolean      @default(false)
  weekdayDayPrice     Float
  weekdayNightPrice   Float
  weekendDayPrice     Float
  weekendNightPrice   Float
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  owner               OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  savedByUsers        SavedTurf[]
  ratings             TurfRating[]

  @@index([ownerProfileId])
  @@index([city])
  @@index([status])
  @@index([name])
  @@index([weekdayDayPrice])
  @@index([createdAt])
  @@index([status, city])
  @@index([status, sportsType])
  @@index([status, weekdayDayPrice])
  @@index([status, city, sportsType])
  @@index([status, city, weekdayDayPrice])
}

model Payment {
  id             String        @id @default(uuid())
  authId         String        @unique
  role           Role
  upiId          String
  userProfileId  String?       @unique
  ownerProfileId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auth           Auth          @relation(fields: [authId], references: [id], onDelete: Cascade)
  ownerProfile   OwnerProfile? @relation(fields: [ownerProfileId], references: [id])
  userProfile    UserProfile?  @relation(fields: [userProfileId], references: [id])

  @@index([authId])
  @@index([role])
}

model Session {
  id        String    @id @default(uuid())
  authId    String
  token     String    @unique @default(uuid())
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  auth      Auth      @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([authId])
}

model OtpEntry {
  id           String    @id @default(uuid())
  authId       String
  sessionToken String    @unique @default(uuid())
  code         String
  expiresAt    DateTime
  verifiedAt   DateTime?
  resendCount  Int       @default(0)
  lastResentAt DateTime?
  createdAt    DateTime  @default(now())
  auth         Auth      @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([authId])
}

model SavedTurf {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  turfId    String   @map("turf_id")
  createdAt DateTime @default(now()) @map("created_at")
  notes     String?
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  user      Auth     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, turfId])
  @@index([userId])
  @@index([turfId])
  @@index([userId, createdAt])
  @@index([turfId, userId])
  @@map("saved_turfs")
}

model Booking {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  turfId            String        @map("turf_id")
  bookingDate       DateTime      @map("booking_date") @db.Date
  startTime         String        @map("start_time")
  endTime           String        @map("end_time")
  durationMins      Int           @map("duration_mins")
  bookingStatus     BookingStatus @default(PENDING) @map("booking_status")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentType       PaymentType   @map("payment_type")
  amount            Float
  depositAmount     Float         @default(0) @map("deposit_amount")
  razorpayOrderId   String?       @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  checkInPin        String?       @map("check_in_pin")
  pinAttempts       Int           @default(0) @map("pin_attempts")
  pinLocked         Boolean       @default(false) @map("pin_locked")
  pinExpiresAt      DateTime?     @map("pin_expires_at")
  visitedAt         DateTime?     @map("visited_at")
  razorpayRefundId  String?       @map("razorpay_refund_id")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelReason      String?       @map("cancel_reason")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  turf              Turf          @relation(fields: [turfId], references: [id], onDelete: Cascade)
  user              Auth          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating            TurfRating?

  @@unique([turfId, bookingDate, startTime])
  @@index([userId])
  @@index([turfId])
  @@index([bookingStatus])
  @@index([bookingDate])
  @@index([paymentStatus])
  @@index([userId, bookingStatus])
  @@index([userId, bookingDate])
  @@index([turfId, bookingDate])
  @@map("bookings")
}

model TurfRating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  turfId    String   @map("turf_id")
  bookingId String   @unique @map("booking_id")
  rating    Int
  review    String?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)
  user      Auth     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookingId])
  @@index([turfId])
  @@index([userId])
  @@map("turf_ratings")
}

enum Role {
  USER
  OWNER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SportsType {
  FOOTBALL
  CRICKET
}

enum TurfStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  ONLINE
  CASH
}
